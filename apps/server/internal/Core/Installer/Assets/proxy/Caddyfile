dhow.example.com {
	header >Strict-Transport-Security "max-age=63072000; includeSubDomains"

	request_body {
		max_size 2MB
	}

	@logstream path_regexp ^/api/v1/organizations/[^/]+/jobs/[^/]+/logs/stream$
	reverse_proxy @logstream 127.0.0.1:8080 {
		flush_interval -1
		transport http {
			read_timeout 1h
		}
	}

	reverse_proxy 127.0.0.1:8080 {
		transport http {
			read_timeout 90s
		}
	}
}
