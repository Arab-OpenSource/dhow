[Unit]
Description=Dhow continuous deployment control plane
Documentation=https://github.com/Khaymah/dhow/blob/main/docs/install/binary-systemd.md
Wants=network-online.target
After=network-online.target postgresql.service postgresql-18.service

[Service]
Type=exec
User=dhow
Group=dhow
ExecStart=/usr/local/bin/dhow-server
EnvironmentFile=/etc/dhow/dhow.env
LoadCredential=dhow-secret-key:/etc/dhow/credentials/dhow-secret-key
LoadCredential=dhow-database-url:/etc/dhow/credentials/dhow-database-url
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
StateDirectory=dhow
StateDirectoryMode=0700
WorkingDirectory=/var/lib/dhow
UMask=0077
LimitNOFILE=65536

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateIPC=yes
DevicePolicy=closed
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
KeyringMode=private
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
