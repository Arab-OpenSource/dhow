{
 "name": "داو",
 "version": 1,
 "default": "sea",
 "groups": [
  "bg",
  "text",
  "aurora",
  "edge",
  "status"
 ],
 "tokens": [
  {
   "key": "canvas",
   "variable": "--color-canvas",
   "group": "bg",
   "usage": "Main content background."
  },
  {
   "key": "rail",
   "variable": "--color-rail",
   "group": "bg",
   "usage": "The icon rail, one step lighter than canvas."
  },
  {
   "key": "input",
   "variable": "--color-input",
   "group": "bg",
   "usage": "Deepest well: the log viewer and command palette input."
  },
  {
   "key": "inset",
   "variable": "--color-surface-inset",
   "group": "bg",
   "usage": "Rows and inputs placed inside a card; table header."
  },
  {
   "key": "surface",
   "variable": "--color-surface",
   "group": "bg",
   "usage": "Card body (end of the card gradient)."
  },
  {
   "key": "raised",
   "variable": "--color-surface-raised",
   "group": "bg",
   "usage": "Hover and selected rows; skeleton blocks."
  },
  {
   "key": "top",
   "variable": "--color-surface-top",
   "group": "bg",
   "usage": "Card top (start of the card gradient); selected segment."
  },
  {
   "key": "track",
   "variable": "--color-track",
   "group": "bg",
   "usage": "Progress and pipeline tracks, disabled fills."
  },
  {
   "key": "t1",
   "variable": "--color-primary",
   "group": "text",
   "usage": "Headings, values, body on canvas and every surface (≥15:1)."
  },
  {
   "key": "t2",
   "variable": "--color-secondary",
   "group": "text",
   "usage": "Labels, list items, icons at rest on canvas and surfaces (≥8:1)."
  },
  {
   "key": "t3",
   "variable": "--color-tertiary",
   "group": "text",
   "usage": "Meta, timestamps, placeholders, inactive rail icons on canvas and surfaces (≥5:1). The lowest tier for readable information."
  },
  {
   "key": "t4",
   "variable": "--color-muted",
   "group": "text",
   "usage": "Disabled only. Never for information the user needs."
  },
  {
   "key": "a1",
   "variable": "--color-aurora-1",
   "group": "aurora",
   "usage": "Aurora dusk stop 1, amber: the leading edge of the brand gradient."
  },
  {
   "key": "a2",
   "variable": "--color-aurora-2",
   "group": "aurora",
   "usage": "Aurora dusk stop 2, apricot."
  },
  {
   "key": "a3",
   "variable": "--color-aurora-3",
   "group": "aurora",
   "usage": "Aurora dusk stop 3, pearl: the bright centre that makes aurora read as light."
  },
  {
   "key": "a4",
   "variable": "--color-aurora-4",
   "group": "aurora",
   "usage": "Aurora dusk stop 4, blush."
  },
  {
   "key": "a5",
   "variable": "--color-aurora-5",
   "group": "aurora",
   "usage": "Aurora dusk stop 5, pink."
  },
  {
   "key": "a6",
   "variable": "--color-aurora-6",
   "group": "aurora",
   "usage": "Aurora dusk stop 6, rose: the trailing edge."
  },
  {
   "key": "edge-warm",
   "variable": "--color-edge-warm",
   "group": "edge",
   "usage": "Edge light, leading (warm) end. Interactive outlines only."
  },
  {
   "key": "edge-cool",
   "variable": "--color-edge-cool",
   "group": "edge",
   "usage": "Edge light, trailing (cool violet) end. Interactive outlines only."
  },
  {
   "key": "green",
   "variable": "--color-accent-green",
   "group": "status",
   "usage": "Category: live / succeeded. Dot, icon, flare, progress fill."
  },
  {
   "key": "blue",
   "variable": "--color-accent-blue",
   "group": "status",
   "usage": "Category: building / running; also the focus ring and primary data series."
  },
  {
   "key": "amber",
   "variable": "--color-accent-amber",
   "group": "status",
   "usage": "Category: awaiting approval. Saturated amber is a state, never the brand (the brand is the pale aurora)."
  },
  {
   "key": "coral",
   "variable": "--color-accent-coral",
   "group": "status",
   "usage": "Category: failed; destructive text actions."
  },
  {
   "key": "violet-soft",
   "variable": "--color-accent-violet-soft",
   "group": "status",
   "usage": "Queued at small sizes (dots)."
  }
 ],
