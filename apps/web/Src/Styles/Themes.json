{
 "name": "داو",
 "version": 2,
 "default": "sea",
 "groups": [
  "bg",
  "text",
  "aurora",
  "edge",
  "status"
 ],
 "tokens": [
  {
   "key": "canvas",
   "variable": "--color-canvas",
   "group": "bg",
   "usage": "Main content background."
  },
  {
   "key": "rail",
   "variable": "--color-rail",
   "group": "bg",
   "usage": "The side menu and the bottom bar, one step lighter than canvas."
  },
  {
   "key": "input",
   "variable": "--color-input",
   "group": "bg",
   "usage": "Deepest well: inputs, the log viewer and the command palette input."
  },
  {
   "key": "inset",
   "variable": "--color-surface-inset",
   "group": "bg",
   "usage": "Banners and quiet blocks placed on canvas."
  },
  {
   "key": "surface",
   "variable": "--color-surface",
   "group": "bg",
   "usage": "Card body and slide body."
  },
  {
   "key": "raised",
   "variable": "--color-surface-raised",
   "group": "bg",
   "usage": "Hover and selected rows, secondary button hover, skeleton blocks."
  },
  {
   "key": "top",
   "variable": "--color-surface-top",
   "group": "bg",
   "usage": "The highest surface: tooltips."
  },
  {
   "key": "track",
   "variable": "--color-track",
   "group": "bg",
   "usage": "Progress and pipeline tracks, disabled fills."
  },
  {
   "key": "t1",
   "variable": "--color-primary",
   "group": "text",
   "usage": "Headings, values, body on canvas and every surface (≥15:1)."
  },
  {
   "key": "t2",
   "variable": "--color-secondary",
   "group": "text",
   "usage": "Labels, row sub-lines, icons at rest on canvas and surfaces (≥7:1)."
  },
  {
   "key": "t3",
   "variable": "--color-tertiary",
   "group": "text",
   "usage": "Meta, timestamps, hints, placeholders on canvas and surfaces (≥4.5:1). The lowest tier for readable information."
  },
  {
   "key": "t4",
   "variable": "--color-muted",
   "group": "text",
   "usage": "Disabled only. Never for information the user needs."
  },
  {
   "key": "a1",
   "variable": "--color-aurora-1",
   "group": "aurora",
   "usage": "Primary button fill, the selected menu icon and the logo sail. Dark text on it keeps ≥4.5:1."
  },
  {
   "key": "a2",
   "variable": "--color-aurora-2",
   "group": "aurora",
   "usage": "Logo gradient stop 2. Used nowhere else."
  },
  {
   "key": "a3",
   "variable": "--color-aurora-3",
   "group": "aurora",
   "usage": "Logo gradient stop 3, the bright centre."
  },
  {
   "key": "a4",
   "variable": "--color-aurora-4",
   "group": "aurora",
   "usage": "Logo gradient stop 4."
  },
  {
   "key": "a5",
   "variable": "--color-aurora-5",
   "group": "aurora",
   "usage": "Logo gradient stop 5."
  },
  {
   "key": "a6",
   "variable": "--color-aurora-6",
   "group": "aurora",
   "usage": "Logo gradient stop 6, the trailing end."
  },
  {
   "key": "edge-warm",
   "variable": "--color-edge-warm",
   "group": "edge",
   "usage": "Kept for saved themes. No component uses it since ADR-0034."
  },
  {
   "key": "edge-cool",
   "variable": "--color-edge-cool",
   "group": "edge",
   "usage": "Kept for saved themes. No component uses it since ADR-0034."
  },
  {
   "key": "green",
   "variable": "--color-accent-green",
   "group": "status",
   "usage": "Category: live / succeeded. Dot, icon, flare, progress fill."
  },
  {
   "key": "blue",
   "variable": "--color-accent-blue",
   "group": "status",
   "usage": "Category: building / running; also the focus ring."
  },
  {
   "key": "amber",
   "variable": "--color-accent-amber",
   "group": "status",
   "usage": "Category: awaiting approval and warnings."
  },
  {
   "key": "coral",
   "variable": "--color-accent-coral",
   "group": "status",
   "usage": "Category: failed; destructive actions."
  },
  {
   "key": "violet-soft",
   "variable": "--color-accent-violet-soft",
   "group": "status",
   "usage": "Queued at small sizes (dots)."
  }
 ],
