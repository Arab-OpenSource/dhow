# Generated by ./init.sh. Never commit the real .env file.

# Password of the dhow database user. URL-safe characters only. init.sh generates 48 hex characters.
POSTGRES_PASSWORD=

# Encrypts secrets at rest. 32 random bytes as hex or base64: openssl rand -hex 32
# Losing this key makes every stored secret unreadable. Back it up.
DHOW_SECRET_KEY=

# The https URL users open. TLS is terminated by your reverse proxy in front of dhow.
DHOW_PUBLIC_URL=

# Optional: pin the image by digest after verifying its signature, for example
# ghcr.io/arab-opensource/dhow@sha256:<digest>
DHOW_IMAGE=

# Optional: where the host publishes dhow. Default 127.0.0.1:8080 (this machine only).
# Use 0.0.0.0:8080 only when nothing else filters access to the port.
DHOW_PUBLISH=

# Optional: comma-separated IPs or CIDRs of reverse proxies whose X-Forwarded-For header is trusted.
DHOW_TRUSTED_PROXIES=

# Optional: debug, info, warn or error.
DHOW_LOG_LEVEL=

# Optional: true (default) checks new passwords against known breaches through the Have I Been Pwned range API
# (only the first 5 characters of the password's SHA-1 leave the server). Set false on isolated networks.
DHOW_BREACHED_PASSWORD_CHECK=

# Optional: who may create more organizations. instance-owner (default) allows only the account made by the
# first-owner setup; any-user allows every signed-in user.
DHOW_ORG_CREATION=

# Optional: rate limits. DHOW_RATE_LIMIT_PUBLIC is the number of requests one client network (an IPv4 address or an
# IPv6 /64) may send in 10 minutes to each group of public sign-in routes (default 300). Raise it when many people
# sign in from behind one NAT. DHOW_RATE_LIMIT_INVITES_USER (default 50) and DHOW_RATE_LIMIT_INVITES_ORG (default 200)
# cap the invitations one member and one organization may send in an hour.
DHOW_RATE_LIMIT_PUBLIC=
DHOW_RATE_LIMIT_INVITES_USER=
DHOW_RATE_LIMIT_INVITES_ORG=

# Optional: a mail server for invitation emails. Leave DHOW_SMTP_HOST empty to turn email off; admins then copy the
# invitation link and send it themselves. DHOW_SMTP_TLS is starttls (default), tls (port 465) or none (a private
# relay without a login only). DHOW_SMTP_FROM is required with a host, for example: Dhow <dhow@example.com>
DHOW_SMTP_HOST=
DHOW_SMTP_PORT=
DHOW_SMTP_TLS=
DHOW_SMTP_USERNAME=
DHOW_SMTP_PASSWORD=
DHOW_SMTP_FROM=
